# Source directory containing raw simulation log files
# Expected structure: SIMULATION_DIR/BotA_vs_BotB/ConfigName/log_[n].json
SIMULATION_DIR=/Users/def/Library/Application Support/DefaultCompany/Sumobot/Logs/Batch/20251231_170916_batch

# Target directory for converted CSV/Parquet files
# Converted files maintain the same structure: BotA_vs_BotB/ConfigName/log.csv or log.parquet
CONVERT_TARGET_DIR=converted

# Directory for batch processing checkpoints
# Contains subdirectories: batch_*.csv, action_timebins/, collision_timebins/, pacing_factors/
BATCH_CHECKPOINT_DIR=batched

# Directory for final summarized analysis results
# Contains: summary_matchup.csv, summary_bot.csv, summary_action_timebins.csv, etc.
SUMMARIZED_TARGET_DIR=result

# Directory for generated arena heatmap visualizations
# Contains subdirectories per bot with phase-based position heatmaps
ARENA_HEATMAP_TARGET_DIR=result/arena_heatmaps
